{
  "name": "hamburg-form-assistant",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Mobile-first PWA that helps fill in the Hamburg residence permit application form (D/TR) entirely on the device.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "sample:pdf": "vite-node scripts/sample-pdf.ts",
    "report:fields": "vite-node scripts/field-report.ts",
    "e2e": "node scripts/e2e-smoke.mjs",
    "qr": "vite-node scripts/qr-poster.ts"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@hookform/resolvers": "5.1.1",
    "@pdf-lib/fontkit": "1.1.1",
    "idb": "8.0.4",
    "lucide-react": "1.63.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "signature_pad": "5.1.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.6",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-node": "6.0.0",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-window": "7.4.1"
  }
}
